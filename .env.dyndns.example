# Template for scripts/strato-dyndns.sh (direct hosting with DNS at STRATO only; not needed with Cloudflare Tunnel).
# Copy to .env.dyndns (ignored by Git and Docker), fill in, then: chmod 600 .env.dyndns
DYNDNS_HOSTS=example.de,www.example.de
STRATO_DYNDNS_USER=example.de
STRATO_DYNDNS_PASSWORD=YOUR_STRATO_DYNDNS_PASSWORD
DYNDNS_INTERFACE=en0
