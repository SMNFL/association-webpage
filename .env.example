PORT=8080
TRUST_PROXY=false

# Required only for npm run editor. Generate both values with:
# npm run security:setup-editor
EDITOR_LOCAL_ONLY=true
EDITOR_PASSWORD_HASH=
EDITOR_SESSION_SECRET=

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Optional: set LOGIN if your provider rejects Nodemailer's default AUTH PLAIN.
SMTP_AUTH_METHOD=
SMTP_USER=mail-user
# Gmail requires a Google App Password. If copied with spaces, the server normalizes it.
SMTP_PASS=mail-password
SMTP_FROM=website@example.org
CONTACT_TO=contact@example.org

# CAPTCHA_PROVIDER can be unset for auto-detection, or set explicitly:
# none, hcaptcha, mcaptcha.
# In production, SMTP contact mail requires a CAPTCHA provider unless
# CONTACT_ALLOW_WITHOUT_CAPTCHA=1 is deliberately set with upstream abuse protection.
CAPTCHA_PROVIDER=
CONTACT_ALLOW_WITHOUT_CAPTCHA=0

# hCaptcha mode. The site key is public; the secret is server-only.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# mCaptcha mode. Point these at your self-hosted mCaptcha deployment.
MCAPTCHA_VERIFY_URL=
MCAPTCHA_SITE_KEY=
MCAPTCHA_SECRET=
MCAPTCHA_WIDGET_URL=
MCAPTCHA_SCRIPT_URL=
